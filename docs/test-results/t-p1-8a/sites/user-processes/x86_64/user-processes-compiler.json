{
  "flags": [
    "--target=x86_64-pc-win32-coff",
    "-O2",
    "-g0",
    "-ffreestanding",
    "-fno-stack-protector",
    "-fno-builtin",
    "-fno-pic",
    "-fno-pie",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-I",
    "/workspace/OS/include",
    "-I",
    "/workspace/OS/boot/x86_64",
    "-DSTYLEOS_EXPECT_ARCH=1",
    "-ffile-prefix-map=/workspace/OS=.",
    "-mno-red-zone",
    "-mno-sse",
    "-mno-mmx",
    "-msoft-float",
    "-DSTYLEOS_TEST_USER_PROCESSES=1"
  ],
  "sources": [
    "kernel/main.c",
    "kernel/boot_info.c",
    "kernel/runtime.c",
    "kernel/boot_memory.c",
    "kernel/boot_memory_diagnostic.c",
    "kernel/exception.c",
    "kernel/boot_pool.c",
    "kernel/user_processes.c",
    "kernel/user_processes_demo.c",
    "arch/x86_64/user_processes.c",
    "arch/x86_64/user_processes_entry.S",
    "boot/x86_64/exit_boot.c",
    "boot/x86_64/uefi.c",
    "boot/x86_64/memory_map.c",
    "arch/x86_64/serial.c",
    "arch/x86_64/entry.S",
    "arch/x86_64/exceptions.c",
    "arch/x86_64/exception_entry.S"
  ]
}
