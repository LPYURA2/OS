{
  "flags": [
    "--target=aarch64-none-elf",
    "-O2",
    "-g0",
    "-ffreestanding",
    "-fno-stack-protector",
    "-fno-builtin",
    "-fno-pic",
    "-fno-pie",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-I",
    "/workspace/OS/include",
    "-I",
    "/workspace/OS/boot/x86_64",
    "-DSTYLEOS_EXPECT_ARCH=2",
    "-ffile-prefix-map=/workspace/OS=.",
    "-mgeneral-regs-only",
    "-mno-outline-atomics",
    "-mstrict-align",
    "-DSTYLEOS_TEST_TASKS=1"
  ],
  "sources": [
    "kernel/main.c",
    "kernel/boot_info.c",
    "kernel/runtime.c",
    "kernel/boot_memory.c",
    "kernel/boot_memory_diagnostic.c",
    "kernel/exception.c",
    "kernel/boot_pool.c",
    "kernel/tasks.c",
    "kernel/tasks_demo.c",
    "arch/aarch64/tasks.c",
    "arch/aarch64/tasks_context.S",
    "boot/aarch64/platform.c",
    "boot/aarch64/start.S",
    "boot/aarch64/fdt_memory.c",
    "arch/aarch64/console.c"
  ]
}
